# The install scripts must be served as plain text so `curl ... | sh` gets the raw bytes.
/install.sh
  Content-Type: text/x-shellscript; charset=utf-8
  Cache-Control: no-cache
/install.ps1
  Content-Type: text/plain; charset=utf-8
  Cache-Control: no-cache

# The engine tarball + bundled house are large, immutable build artifacts — cache hard.
/app/typehaus-engine.tar
  Cache-Control: public, max-age=31536000, immutable
/app/catlin-house.json
  Cache-Control: public, max-age=31536000, immutable

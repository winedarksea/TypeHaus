{
  "name": "typehaus-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Type:Haus M2 editor — SVG 2D editor + three.js 3D panel over model.json (→ 21).",
  "scripts": {
    "dev": "node scripts/build-pwa-assets.mjs && node scripts/build-house-asset.mjs && vite",
    "prebuild": "node scripts/build-pwa-assets.mjs && node scripts/build-house-asset.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node scripts/run-geometry-tests.mjs",
    "shots": "npm run build && node scripts/shoot.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
